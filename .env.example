# Copier ce fichier en .env et le remplir. .env n'est jamais versionné.

# --- Modèle ---------------------------------------------------------------
# Un provider déclaré dans config/models.json, qui passe par le coffre (voir README).
DOT_PROVIDER=local
DOT_MODEL=mon-modele
# off, minimal, low, medium, high, xhigh, max
DOT_THINKING=medium

# Aucun secret ici : ce fichier est visible du dot. Les clés d'API et le jeton du bot Telegram
# vont dans config/vault.json, que seul le coffre lit.

# --- Interface -----------------------------------------------------------
# tui : pi dans un terminal (./dot attach). rpc : pi en mode RPC, joignable par un socket
# (./dot rpc, ou tout client qui sait piloter `pi --mode rpc`). Les canaux (Telegram,
# ./dot chat) marchent dans les deux cas.
DOT_INTERFACE=tui

# --- Telegram -------------------------------------------------------------
# Ton identifiant Telegram (@userinfobot) ; le jeton du bot est dans config/vault.json.
# Vide : pas de Telegram.
TELEGRAM_OWNER_ID=

# --- Autonomie ------------------------------------------------------------
# Le battement lit le plan sans le modèle ; un run n'est lancé que s'il y a quelque chose à faire.
# Objectif sans progrès après un nouveau plan : réexaminé au plus tôt après N minutes.
DOT_RECHECK_MINUTES=60
# Durée maximale d'un run de travail (minutes), et runs sur un même todo avant de demander de l'aide.
DOT_RUN_MINUTES=30
DOT_MAX_RUNS=3

# --- Ressources -----------------------------------------------------------
# Au-delà, un processus du dot est arrêté au lieu de saturer la machine (pas d'échange disque).
DOT_MEMORY=8g
DOT_CPUS=4
DOT_PIDS=2048

# Fuseau horaire des tâches planifiées
TZ=Europe/Paris
