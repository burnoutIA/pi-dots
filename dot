#!/usr/bin/env bash
# dot — l'application des dots (docker ou podman).
#
# Un dot est un dossier, où qu'il soit sur le disque :
#   travail/
#     travail.dot     son fichier : en-tête (name, description), env, model, vault
#     skills/  extensions/   ses savoir-faire
#     state/          sa vie (mémoire, sessions, journal, fichiers)
# Copier tout le dossier : le même dot. Le copier sans state/ : un dot vierge (./dot copie … --vierge).
#
#   ./dot create nom [--dans dossier] [--depuis dot]   créer un dot (par défaut dans dots/)
#   ./dot copie dot destination [--vierge]           copier un dot (--vierge : sans sa vie, sans Telegram)
#   ./dot list [--json]      les dots connus, et lesquels tournent
#   ./dot use dot            le dot par défaut ;  ./dot remove dot --yes : le supprimer
#   ./dot associer           ouvrir les fichiers .dot avec cette application (Linux, à l'installation)
#   ./dot veilleur install   le veilleur : allumer/éteindre tous les dots depuis Telegram (uninstall, status)
#   ./dot build              construire l'image (commune à tous les dots)
#   ./dot test               lancer les tests automatiques
#
# Pour un dot (./dot @nom …, ./dot chemin/du/dossier-ou-fichier.dot …, ou le dot par défaut) :
#   start / stop / open     allumer / éteindre / allumer puis faire ce que dit « onclic » (double-clic)
#   chat, ask "…", send fichier, livrables, secret, suivre, rpc, attach, shell
#   doctor, journal, status [--json], logs
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="${DOT_IMAGE:-dots:latest}"
DOTS_HOME="${DOTS_HOME:-$ROOT/dots}"                  # où se créent les nouveaux dots
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/dots"      # le registre des dots connus
KNOWN="$DATA/known"                                    # lignes « nom<TAB>dossier »
CURRENT="$DATA/courant"
NET_EXTERNAL=dot-external                              # commun aux coffres : internet et la machine hôte
PROXY="http://dot-vault:8080"
VEILLEUR_UNIT=dots-veilleur.service                    # un seul veilleur, pour tous les dots
mkdir -p "$DATA"; touch "$KNOWN"

if [ -n "${DOT_ENGINE:-}" ]; then ENGINE="$DOT_ENGINE"
elif command -v podman >/dev/null; then ENGINE=podman
elif command -v docker >/dev/null; then ENGINE=docker
else echo "Il faut docker ou podman." >&2; exit 1
fi

valid_name() { [[ "$1" =~ ^[a-z][a-z0-9-]{0,30}$ ]]; }
running() { [ "$($ENGINE inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = "true" ]; }
network() { $ENGINE network inspect "$1" >/dev/null 2>&1 || $ENGINE network create "${@:2}" "$1" >/dev/null; }
userns() { [ "$ENGINE" = podman ] && echo "--userns=keep-id" || true; }
ensure_image() { $ENGINE image inspect "$IMAGE" >/dev/null 2>&1 || $ENGINE build -t "$IMAGE" -f "$ROOT/Containerfile" "$ROOT"; }
# Le fichier .dot se lit dans l'image (YAML) : node /opt/dot/dotfile.mjs, avec les montages donnés.
dotfile_tool() { ensure_image; $ENGINE run --rm $(userns) --entrypoint node "$@"; }
id_of() { printf 'dot-%s-%s' "$1" "$(printf '%s' "$2" | sha1sum | cut -c1-6)"; }   # nom dossier → conteneur

# --- Le registre des dots connus ------------------------------------------------------------
dotfile_of() { # dossier → son fichier .dot (un seul)
  local files=("$1"/*.dot)
  [ -e "${files[0]}" ] || return 1
  [ "${#files[@]}" -eq 1 ] || { echo "Plusieurs fichiers .dot dans $1 : il en faut un seul." >&2; return 1; }
  echo "${files[0]}"
}
remember() { # nom dossier
  local tmp; tmp="$(mktemp)"
  awk -F'\t' -v d="$2" '$2 != d' "$KNOWN" > "$tmp"; printf '%s\t%s\n' "$1" "$2" >> "$tmp"; mv "$tmp" "$KNOWN"
}
forget() { local tmp; tmp="$(mktemp)"; awk -F'\t' -v d="$1" '$2 != d' "$KNOWN" > "$tmp"; mv "$tmp" "$KNOWN"; }
known_dirs() { awk -F'\t' '{print $2}' "$KNOWN" | while read -r d; do [ -n "$d" ] && dotfile_of "$d" >/dev/null 2>&1 && echo "$d"; done; return 0; }
dir_of_name() { # nom → dossier (le registre, sinon DOTS_HOME/nom)
  local d; d="$(awk -F'\t' -v n="$1" '$1 == n {print $2}' "$KNOWN" | tail -1)"
  [ -n "$d" ] && dotfile_of "$d" >/dev/null 2>&1 && { echo "$d"; return; }
  [ -d "$DOTS_HOME/$1" ] && dotfile_of "$DOTS_HOME/$1" >/dev/null 2>&1 && { echo "$DOTS_HOME/$1"; return; }
  return 1
}
resolve() { # @nom | chemin → dossier
  local t="$1"
  if [ "${t#@}" != "$t" ]; then dir_of_name "${t#@}" || { echo "Pas de dot « ${t#@} » (./dot list)." >&2; exit 1; }
  elif [ -f "$t" ] && [ "${t%.dot}" != "$t" ]; then (cd "$(dirname "$t")" && pwd)
  elif [ -d "$t" ]; then (cd "$t" && pwd)
  elif valid_name "$t" && dir_of_name "$t"; then :   # un simple nom
  else echo "Pas de dot « $t » (./dot list)." >&2; exit 1; fi
}

# --- Le dot visé ----------------------------------------------------------------------------
TARGET=""
if [ -n "${1:-}" ] && { [ "${1#@}" != "$1" ] || [ -d "$1" ] || [ "${1%.dot}" != "$1" ]; }; then TARGET="$1"; shift; fi
GLOBAL=" create copie list use remove associer build test help veilleur "
if [ -z "$TARGET" ] && [[ "$GLOBAL" != *" ${1:-help} "* ]]; then
  if [ -n "${DOT_NAME:-}" ]; then TARGET="@$DOT_NAME"
  elif [ -s "$CURRENT" ]; then TARGET="$(cat "$CURRENT")"
  elif [ "$(known_dirs | wc -l)" -eq 1 ]; then TARGET="$(known_dirs)"
  else echo "Quel dot ? ./dot @nom ${1:-}  (ou ./dot use nom ; ./dot list)" >&2; exit 1; fi
fi

if [ -n "$TARGET" ]; then
  DIR="$(resolve "$TARGET")"
  DOTFILE="$(dotfile_of "$DIR")" || { echo "Pas de fichier .dot dans $DIR." >&2; exit 1; }
  NAME="$(basename "$DOTFILE" .dot)"
  valid_name "$NAME" || { echo "Nom de fichier invalide : $(basename "$DOTFILE") (minuscules, chiffres et tirets)." >&2; exit 1; }
  # Deux copies d'un même dot, à deux endroits, ont chacune leurs conteneurs.
  ID="$(id_of "$NAME" "$DIR")"
  VAULT="$ID-vault"; NET_INTERNAL="$ID-net"
  STATE="$DIR/state"; RUN="$STATE/.run"
  remember "$NAME" "$DIR"
  # Ce que les outils de la machine (tools/*.py) doivent savoir du dot visé.
  export DOT_NAME="$NAME" DOT_DIR="$DIR" DOT_STATE="$STATE" DOT_CONTAINER="$ID" DOT_VAULT_NAME="$VAULT" DOT_ENGINE_BIN="$ENGINE" DOT_CLI="$ROOT/dot"
fi

# env et model sont extraits du fichier pour le dot, qui ne voit jamais ce fichier (le vault y est).
extract() {
  mkdir -p "$RUN"
  dotfile_tool -v "$DOTFILE:/dot.dot:ro" -v "$RUN:/run-out" "$IMAGE" /opt/dot/dotfile.mjs extract /dot.dot /run-out
}
setting() { grep -E "^$1=" "$RUN/env" 2>/dev/null | tail -1 | cut -d= -f2-; }
interface_of() { grep -E '^\s*DOT_INTERFACE:' "$(dotfile_of "$1")" 2>/dev/null | head -1 | sed -E 's/^\s*DOT_INTERFACE:\s*"?([a-z]+).*/\1/' || true; }

json_status() { # dossier → objet JSON
  local d="$1" f n id run=false vrun=false iface
  f="$(dotfile_of "$d")"; n="$(basename "$f" .dot)"; id="$(id_of "$n" "$d")"
  running "$id" && run=true
  running "$id-vault" && vrun=true
  iface="$(interface_of "$d")"
  printf '{"name":"%s","running":%s,"vault":%s,"interface":"%s","dir":"%s","file":"%s","socket":"%s"}' \
    "$n" "$run" "$vrun" "${iface:-tui}" "$d" "$f" "$d/state/channel/rpc.sock"
}

start_vault() {
  running "$VAULT" && return
  $ENGINE rm -f "$VAULT" >/dev/null 2>&1 || true
  local args=(
    -d --name "$VAULT" --hostname dot-vault
    --memory 256m --cpus 1 --pids-limit 256
    # Le dossier du dot, pour son fichier .dot : le coffre y écrit les secrets donnés par la personne,
    # et le relit quand elle le modifie. Le dossier entier, et non le fichier seul : un éditeur qui
    # enregistre en remplaçant le fichier laisserait sinon le coffre sur l'ancienne version.
    -v "$DIR:/vault/dir"
    -e "VAULT_CONFIG=/vault/dir/$(basename "$DOTFILE")"
    -e "DOT_FILE=$DOTFILE"
    -v "$STATE/logs:/logs"
    -v "$STATE/inbox:/inbox"
    -e "TZ=$(setting TZ)"
    -e "TELEGRAM_OWNER_ID=$(setting TELEGRAM_OWNER_ID)"
    -e "DOT_NAME=$NAME"
    --add-host host.docker.internal:host-gateway
    --entrypoint node
  )
  if [ "$ENGINE" = podman ]; then
    args+=(--userns keep-id --network "$NET_INTERNAL:alias=dot-vault" --network "$NET_EXTERNAL")
    $ENGINE run "${args[@]}" "$IMAGE" /opt/dot/vault/vault.mjs >/dev/null
  else
    $ENGINE run "${args[@]}" --network "$NET_EXTERNAL" "$IMAGE" /opt/dot/vault/vault.mjs >/dev/null
    $ENGINE network connect --alias dot-vault "$NET_INTERNAL" "$VAULT"
  fi
}

copy_dot() { # source destination vierge(0|1)
  local src="$1" dest="$2" blank="$3" sname dname
  sname="$(basename "$(dotfile_of "$src")" .dot)"
  dname="$(basename "$dest")"
  valid_name "$dname" || { echo "Le dossier de destination doit porter un nom valide : $dname (minuscules, chiffres et tirets)." >&2; exit 1; }
  [ -e "$dest" ] && { echo "$dest existe déjà." >&2; exit 1; }
  mkdir -p "$dest"
  if [ "$blank" = 1 ]; then
    for d in skills extensions; do [ -d "$src/$d" ] && cp -a "$src/$d" "$dest/$d"; done
    dotfile_tool -v "$src:/src:ro" -v "$dest:/dest" "$IMAGE" /opt/dot/dotfile.mjs blank "/src/$sname.dot" "/dest/$dname.dot" "$dname"
  else
    if [ "$ENGINE" = podman ]; then podman unshare cp -a "$src/." "$dest/"; else cp -a "$src/." "$dest/"; fi
    [ "$sname" != "$dname" ] && mv "$dest/$sname.dot" "$dest/$dname.dot"
    rm -rf "$dest/state/.run" "$dest/state/channel/rpc.sock"
  fi
  mkdir -p "$dest"/{skills,extensions,state}
  remember "$dname" "$dest"
}

case "${1:-help}" in
  create)
    new="${2:-}"; where="$DOTS_HOME"; from=""
    valid_name "$new" || { echo "Usage : ./dot create nom [--dans dossier] [--depuis dot]" >&2; exit 1; }
    shift 2; while [ $# -gt 0 ]; do case "$1" in --dans) where="$2"; shift 2;; --depuis) from="$2"; shift 2;; *) shift;; esac; done
    target="$(mkdir -p "$where" && cd "$where" && pwd)/$new"
    if [ -n "$from" ]; then
      copy_dot "$(resolve "$from")" "$target" 1
      echo "Dot « $new » créé dans $target, à partir de « $from » (vierge, sans Telegram)."
    else
      [ -e "$target" ] && { echo "$target existe déjà." >&2; exit 1; }
      mkdir -p "$target"/{skills,extensions,state}
      dotfile_tool -v "$target:/d" "$IMAGE" /opt/dot/dotfile.mjs new "/d/$new.dot" "$new"
      remember "$new" "$target"
      echo "Dot « $new » créé dans $target : remplis $new.dot (description, env, model, vault)."
    fi
    echo "Lance-le avec : ./dot @$new start"
    ;;
  copie)
    [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "Usage : ./dot copie dot destination [--vierge]" >&2; exit 1; }
    src="$(resolve "$2")"; dest="$3"
    [ "${dest#/}" = "$dest" ] && [ "${dest#.}" = "$dest" ] && dest="$DOTS_HOME/$dest"   # un simple nom : dans dots/
    dest="$(mkdir -p "$(dirname "$dest")" && cd "$(dirname "$dest")" && pwd)/$(basename "$dest")"
    if [ "${4:-}" = "--vierge" ]; then copy_dot "$src" "$dest" 1; echo "Copie vierge créée : $dest (config, secrets, skills ; sans sa vie ni Telegram)."
    else copy_dot "$src" "$dest" 0; echo "Copie complète créée : $dest (pense à lui donner son propre bot Telegram)."; fi
    ;;
  list)
    if [ "${2:-}" = "--json" ]; then
      first=1; printf '['
      for d in $(known_dirs); do [ $first = 1 ] || printf ','; first=0; json_status "$d"; done
      printf ']\n'
    else
      current="$(cat "$CURRENT" 2>/dev/null || true)"
      for d in $(known_dirs); do
        f="$(dotfile_of "$d")"; n="$(basename "$f" .dot)"
        st="éteint"; running "$(id_of "$n" "$d")" && st="allumé"
        mark=" "; [ "$current" = "$d" ] && mark="*"
        iface="$(interface_of "$d")"
        printf '%s %-16s %-8s %-4s %s\n' "$mark" "$n" "$st" "${iface:-tui}" "$d"
      done
    fi
    ;;
  use)
    d="$(resolve "${2:?Usage : ./dot use dot}")"; echo "$d" > "$CURRENT"; echo "Dot par défaut : $d"
    ;;
  remove)
    d="$(resolve "${2:?Usage : ./dot remove dot --yes}")"
    [ "${3:-}" = "--yes" ] || { echo "Supprimer ce dot efface son dossier entier, sa mémoire et ses secrets ($d). Confirme : ./dot remove ${2} --yes" >&2; exit 1; }
    "$0" "$d" stop >/dev/null 2>&1 || true
    id="$(id_of "$(basename "$(dotfile_of "$d")" .dot)" "$d")"
    $ENGINE network rm "$id-net" >/dev/null 2>&1 || true
    if [ "$ENGINE" = podman ]; then podman unshare rm -rf "$d"; else rm -rf "$d"; fi
    forget "$d"; [ "$(cat "$CURRENT" 2>/dev/null || true)" = "$d" ] && rm -f "$CURRENT"
    echo "Dot supprimé : $d"
    ;;
  associer)
    # Ouvrir les fichiers .dot avec cette application : type MIME, lanceur, application par défaut.
    command -v xdg-mime >/dev/null || { echo "Association automatique : Linux (xdg) seulement pour l'instant." >&2; exit 1; }
    mkdir -p "$HOME/.local/share/mime/packages" "$HOME/.local/share/applications"
    cat > "$HOME/.local/share/mime/packages/dots.xml" <<XML
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-dot-agent">
    <comment>Dot (agent pi autonome)</comment>
    <glob pattern="*.dot" weight="60"/>
  </mime-type>
</mime-info>
XML
    cat > "$HOME/.local/share/applications/dots.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Dots
Comment=Allumer un dot et lui parler
Exec=$ROOT/dot %f open
Terminal=false
MimeType=application/x-dot-agent;
Categories=Utility;
DESKTOP
    update-mime-database "$HOME/.local/share/mime" >/dev/null 2>&1 || true
    update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
    xdg-mime default dots.desktop application/x-dot-agent
    echo "Les fichiers .dot s'ouvrent maintenant avec Dots : un double-clic lance le dot, puis fait ce que dit « onclic » (chat ou none)."
    ;;
  build)
    $ENGINE build -t "$IMAGE" -f "$ROOT/Containerfile" "$ROOT"
    ;;
  test)
    # Les tests tournent dans l'image (Node 24), sur le code du dépôt tel qu'il est : pas besoin de reconstruire.
    ensure_image
    $ENGINE run --rm -v "$ROOT/image:/src:ro" -v "$ROOT/tests:/tests:ro" --entrypoint node "$IMAGE" --test "/tests/*.test.*"
    ;;
  start)
    if running "$ID"; then echo "Le dot « $NAME » tourne déjà."; exit 0; fi
    # Créés ici, à l'utilisateur de la machine : sinon le moteur les crée lui-même, à un autre propriétaire.
    mkdir -p "$DIR"/{skills,extensions} "$STATE"/{agent,memory,inbox,workspace,browser,logs,channel/in,channel/out,livrables}
    extract || { echo "Le fichier $DOTFILE ne peut pas être utilisé tel quel (voir ci-dessus)." >&2; exit 1; }
    network "$NET_INTERNAL" --internal
    network "$NET_EXTERNAL"
    start_vault

    $ENGINE rm -f "$ID" >/dev/null 2>&1 || true
    memory="$(setting DOT_MEMORY)"; cpus="$(setting DOT_CPUS)"; pids="$(setting DOT_PIDS)"
    args=(
      -d --name "$ID" --hostname "$NAME"
      --memory "${memory:-8g}" --memory-swap "${memory:-8g}"
      --cpus "${cpus:-4}"
      --pids-limit "${pids:-2048}"
      --network "$NET_INTERNAL"
      --env-file "$RUN/env"
      -e "DOT_VAULT=$PROXY"
      -e "HTTP_PROXY=$PROXY" -e "HTTPS_PROXY=$PROXY" -e "http_proxy=$PROXY" -e "https_proxy=$PROXY"
      -e "NO_PROXY=dot-vault,localhost,127.0.0.1" -e "no_proxy=dot-vault,localhost,127.0.0.1"
      -e "NODE_USE_ENV_PROXY=1"
      # Sa vie, ses skills, ses extensions, ses providers (model). Jamais son fichier .dot.
      -v "$STATE:/dot"
      -v "$DIR/skills:/dot/agent/skills"
      -v "$DIR/extensions:/dot/agent/extensions"
      -v "$RUN/models.json:/opt/dot/config/models.json:ro"
      --shm-size 1g
    )
    # podman sans root : les fichiers restent à l'utilisateur de la machine.
    [ "$ENGINE" = podman ] && args+=(--userns keep-id)
    $ENGINE run "${args[@]}" "$IMAGE" >/dev/null
    echo "Dot « $NAME » lancé, derrière son coffre ($DIR)."
    ;;
  stop)
    # podman sans root (Ubuntu) peut échouer à couper son processus réseau (pasta) quand le dernier
    # conteneur part : « rootless netns: kill network process ». Sans conséquence, on l'ignore.
    quiet() { "$@" 2>&1 | grep -v -e "rootless netns" -e "^\s*\*" -e "^Error: removing container" -e "^$" -e "^$ID$" -e "^$VAULT$" >&2 || true; }
    if running "$ID"; then quiet $ENGINE stop -t 20 "$ID"; fi
    if running "$VAULT"; then quiet $ENGINE stop -t 5 "$VAULT"; fi
    $ENGINE rm -f "$ID" "$VAULT" >/dev/null 2>&1 || true
    echo "Dot « $NAME » arrêté. Il reprendra au prochain démarrage."
    ;;
  open)
    # Le double-clic sur un .dot : le dot est toujours lancé, puis ce que dit « onclic » dans son en-tête :
    #   chat (par défaut) : la conversation, dans un terminal ; none : rien de plus (une app prend la main).
    running "$ID" || "$0" "$DIR" start
    onclic="$(sed -n '2,/^---$/p' "$DOTFILE" | grep -E '^onclic:' | head -1 | sed -E 's/^onclic:\s*"?([a-z]+).*/\1/')"
    case "${onclic:-chat}" in
      none) ;;
      chat)
        if [ -t 0 ] && [ -t 1 ]; then exec python3 -I "$ROOT/tools/chat.py" chat; fi
        # Lancé sans terminal (double-clic) : on en ouvre un.
        for term in x-terminal-emulator gnome-terminal konsole xfce4-terminal xterm; do
          command -v "$term" >/dev/null || continue
          case "$term" in gnome-terminal) exec "$term" -- "$0" "$DIR" chat ;; *) exec "$term" -e "$0" "$DIR" chat ;; esac
        done
        echo "Pas de terminal trouvé : lance ./dot @$NAME chat." >&2; exit 1 ;;
      *) echo "onclic inconnu dans $(basename "$DOTFILE") : « $onclic » (chat ou none)." >&2; exit 1 ;;
    esac
    ;;
  attach)
    running "$ID" || { echo "Le dot « $NAME » ne tourne pas : ./dot @$NAME start." >&2; exit 1; }
    if [ "$(interface_of "$DIR")" = "rpc" ]; then
      echo "Ce dot est en mode RPC (DOT_INTERFACE: rpc) : pas de terminal. Utilise ./dot chat, ou un client RPC avec ./dot rpc." >&2; exit 1
    fi
    $ENGINE exec -it "$ID" tmux attach -t dot
    ;;
  rpc)
    # Connecteur RPC : remplace `pi --mode rpc` pour un client (les options sont ignorées).
    shift
    exec python3 -I "$ROOT/tools/rpc.py" "$@"
    ;;
  shell)
    running "$ID" || { echo "Le dot « $NAME » ne tourne pas." >&2; exit 1; }
    $ENGINE exec -it "$ID" bash
    ;;
  doctor)
    echo "Machine hôte (dot « $NAME », $DIR) :"
    echo "✅ moteur : $ENGINE"
    if ! $ENGINE image inspect "$IMAGE" >/dev/null 2>&1; then echo "❌ image absente — ./dot build"
    else
      built=$(date -u -d "$($ENGINE image inspect -f '{{.Created}}' "$IMAGE" | cut -d. -f1 | cut -c1-19)" +%s 2>/dev/null || echo 0)
      newest=$(find "$ROOT/image" "$ROOT/Containerfile" -type f -printf '%T@\n' | sort -n | tail -1 | cut -d. -f1)
      if [ "$built" -gt 0 ] && [ "$newest" -gt "$built" ]; then echo "⚠️ image plus ancienne que le code — ./dot build puis redémarrer le dot"
      else echo "✅ image à jour"; fi
    fi
    if err="$(extract 2>&1 >/dev/null)"; then echo "✅ $(basename "$DOTFILE") lisible, aucun secret visible du dot"
    else echo "❌ $(basename "$DOTFILE") : $err"; fi
    running "$VAULT" && echo "✅ coffre en marche" || echo "❌ coffre arrêté — ./dot @$NAME start"
    if [ -n "$(setting TELEGRAM_OWNER_ID)" ]; then
      if systemctl --user is-active "$VEILLEUR_UNIT" >/dev/null 2>&1; then echo "✅ veilleur en marche (allumer/éteindre depuis Telegram)"
      else echo "⚠️ veilleur arrêté — /allumer et /eteindre ne marchent pas depuis Telegram (./dot veilleur install)"; fi
    fi
    if running "$ID"; then
      iface="$(interface_of "$DIR")"
      echo "✅ dot en marche (${iface:-tui})"; echo; echo "Intérieur du dot :"
      $ENGINE exec "$ID" node /opt/dot/doctor.mjs
    else echo "❌ dot arrêté — ./dot @$NAME start"; fi
    ;;
  veilleur)
    # Le veilleur : allume et éteint les dots depuis Telegram. Un seul, pour tous les dots connus.
    # Service de session (Linux, systemd).
    unit="$HOME/.config/systemd/user/$VEILLEUR_UNIT"
    case "${2:-status}" in
      install)
        command -v systemctl >/dev/null || { echo "Installation automatique : Linux (systemd) seulement pour l'instant. Sinon : ./dot veilleur run" >&2; exit 1; }
        mkdir -p "$(dirname "$unit")"
        cat > "$unit" <<UNIT
[Unit]
Description=Veilleur des dots : les allumer et les éteindre depuis Telegram

[Service]
ExecStart=$(command -v python3) -I $ROOT/tools/veilleur.py
Environment=DOT_ENGINE_BIN=$ENGINE
Environment=DOT_CLI=$ROOT/dot
Environment=PATH=$PATH
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
UNIT
        systemctl --user daemon-reload && systemctl --user enable --now "$VEILLEUR_UNIT"
        echo "Veilleur installé et lancé : il veille sur tous les dots connus, et démarrera avec ta session."
        ;;
      uninstall)
        systemctl --user disable --now "$VEILLEUR_UNIT" 2>/dev/null || true
        rm -f "$unit"; systemctl --user daemon-reload 2>/dev/null || true
        echo "Veilleur retiré."
        ;;
      run) DOT_ENGINE_BIN="$ENGINE" DOT_CLI="$ROOT/dot" python3 -I "$ROOT/tools/veilleur.py" ;;
      status|*) systemctl --user is-active "$VEILLEUR_UNIT" >/dev/null 2>&1 && echo "Le veilleur tourne." || echo "Le veilleur ne tourne pas (./dot veilleur install)." ;;
    esac
    ;;
  telegram-config)
    # Pour le veilleur : l'identifiant de la personne puis le jeton du bot (lus dans le fichier du dot).
    dotfile_tool -v "$DOTFILE:/dot.dot:ro" "$IMAGE" -e '
      import("/opt/dot/dotfile.mjs").then(({ read, readVault }) => {
        const env = read("/dot.dot").body.toJS()?.env ?? {};
        console.log(String(env.TELEGRAM_OWNER_ID ?? ""));
        console.log(String(readVault("/dot.dot").secrets?.TELEGRAM_TOKEN?.value ?? ""));
      });'
    ;;
  suivre)
    python3 -I "$ROOT/tools/suivre.py"
    ;;
  ask|chat|send|secret|livrables)
    # Le canal local : le même que Telegram, depuis la machine. Les secrets vont directement au coffre.
    python3 -I "$ROOT/tools/chat.py" "$@"
    ;;
  journal)
    shift
    python3 -I "$ROOT/tools/journal.py" "$@"
    ;;
  logs)
    $ENGINE logs "$VAULT" 2>&1 | tail -20 | sed "s/^/[coffre] /"
    $ENGINE logs -f "$ID"
    ;;
  status)
    if [ "${2:-}" = "--json" ]; then json_status "$DIR"; echo; exit 0; fi
    if running "$ID"; then echo "Le dot « $NAME » tourne ($ENGINE, $DIR)."; else echo "Le dot « $NAME » ne tourne pas ($DIR)."; fi
    if running "$VAULT"; then echo "Son coffre tourne."; else echo "Son coffre ne tourne pas."; fi
    ;;
  help|*)
    sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
